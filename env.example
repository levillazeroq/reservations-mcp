# =============================================================================
# MCP ZeroQ Reservations - Configuration
# =============================================================================
# Copia este archivo a .env y configura tus valores
# cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Puerto donde correrá el servidor MCP
MCP_PORT=3000

# API Key para autenticar peticiones al MCP
# IMPORTANTE: Cambia este valor en producción
# Genera una clave segura: openssl rand -hex 32
MCP_PUBLIC_API_KEY=change-me-strong-key

# Zona horaria para el servidor
# Ver: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
MCP_TZ=America/Santiago

# -----------------------------------------------------------------------------
# OpenAI Configuration (para el agente inteligente)
# -----------------------------------------------------------------------------
# Tu API Key de OpenAI
# Obtén una en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modelo de OpenAI a usar
# Opciones: gpt-4o-mini (recomendado, económico), gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# Máximo de tokens en cada respuesta del agente
# Valor recomendado: 2000 (suficiente para respuestas completas)
OPENAI_MAX_TOKENS=2000

# Temperatura del modelo (0.0 = determinista, 1.0 = creativo)
# Valor recomendado: 0.7 (buen balance)
OPENAI_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# ZeroQ Provider Configuration (NO expuesto a clientes externos)
# -----------------------------------------------------------------------------
# URL base de ZeroQ
ZEROQ_BASE_URL=https://zeroq.cl

# URL base de la API v3 de ZeroQ
ZEROQ_API_BASE_URL=https://zeroq.cl/api

# URL base del servicio de reservas
ZEROQ_RESERVATIONS_BASE_URL=https://zeroq.cl/services/reservations/api/v3

# URL base del servicio de bloques
ZEROQ_BLOCKS_BASE_URL=https://services.zeroq.cl/reservations/api/v3

# Token de autenticación de ZeroQ
# Token JWT para autenticar peticiones a las APIs de ZeroQ
# Este token se usa automáticamente en las operaciones que lo requieren
# Si no se proporciona, las operaciones públicas seguirán funcionando
ZEROQ_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Nivel de logs: error, warn, log, debug, verbose
LOG_LEVEL=info

# Entorno de ejecución
# Valores: development, production, test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Notas de Seguridad
# -----------------------------------------------------------------------------
# 1. NUNCA subas el archivo .env al repositorio
# 2. Agrega .env al .gitignore
# 3. Usa valores diferentes para desarrollo y producción
# 4. Rota las API Keys regularmente
# 5. En producción, usa variables de entorno del sistema o secrets manager

# -----------------------------------------------------------------------------
# Ejemplo de configuración para diferentes ambientes
# -----------------------------------------------------------------------------

# DESARROLLO (local)
# MCP_PUBLIC_API_KEY=dev-local-key-123
# LOG_LEVEL=debug
# NODE_ENV=development

# STAGING/QA
# MCP_PUBLIC_API_KEY=staging-secure-key-456
# LOG_LEVEL=info
# NODE_ENV=production

# PRODUCCIÓN
# MCP_PUBLIC_API_KEY=prod-ultra-secure-key-789
# LOG_LEVEL=warn
# NODE_ENV=production

