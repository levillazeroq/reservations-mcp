# ============================================
# Variables de Entorno para Railway
# ============================================
# Copia estas variables al dashboard de Railway
# Settings → Variables → Raw Editor
# ============================================

# Puerto del servidor (Railway lo asigna automáticamente, pero 3030 es el default)
PORT=3030

# Entorno de ejecución
NODE_ENV=production

# ============================================
# ZEROQ API CONFIGURATION (REQUERIDO)
# ============================================

# Token de autenticación de ZeroQ
# Obtenerlo desde el panel de ZeroQ
ZEROQ_AUTH_TOKEN=eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJ...tu-token-completo-aqui...

# URLs de los servicios de ZeroQ (Producción)
ZEROQ_BASE_URL=https://zeroq.cl/services/locations/api/v2
ZEROQ_BLOCKS_BASE_URL=https://zeroq.cl/services/reserves/api/v2
ZEROQ_RESERVATIONS_BASE_URL=https://zeroq.cl/services/reservations/api/v3

# ============================================
# MCP CONFIGURATION (REQUERIDO)
# ============================================

# API Key para proteger los endpoints MCP
# Cambiar por una clave fuerte y segura
MCP_PUBLIC_API_KEY=change-me-to-a-strong-secret-key

# ============================================
# OPENAI CONFIGURATION (OPCIONAL)
# ============================================

# API Key de OpenAI (solo si usarás el chatAgent)
# Si no usas chatAgent, puedes omitir esta variable
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai-aqui

# ============================================
# INSTRUCCIONES DE CONFIGURACIÓN EN RAILWAY
# ============================================
# 
# 1. Ve a tu proyecto en Railway dashboard
# 2. Selecciona tu servicio
# 3. Ve a "Variables" en el menú lateral
# 4. Click en "Raw Editor"
# 5. Copia y pega el contenido de este archivo
# 6. Reemplaza los valores con tus credenciales reales
# 7. Click en "Update Variables"
# 8. Railway redesplegará automáticamente
#
# ============================================

